{
  "name": "@stuhelper/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "preview": "vite preview --port 5173",
    "generate": "openapi-typescript contracts/platform.openapi.yaml -o src/api/platform.gen.ts",
    "check": "npm run check:i18n && npm run typecheck && npm run lint && npm test && npm run build",
    "check:i18n": "node scripts/check-i18n.mjs && node --test scripts/i18n.node.mjs"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}

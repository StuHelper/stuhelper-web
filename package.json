{
  "name": "@stuhelper/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.33.4"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "build": "pnpm run typecheck && vite build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "preview": "vite preview --port 5173",
    "generate": "openapi-typescript contracts/platform.openapi.yaml -o src/api/platform.gen.ts",
    "check": "pnpm run check:i18n && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build",
    "check:i18n": "stuhelper-check i18n"
  },
  "dependencies": {
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-vue": "10.11.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "@stuhelper/engineering-tools": "git+https://github.com/StuHelper/stuhelper-next.git#360f0e9c02738117d1aa8cdac090cf0bae11f217"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "katex": "0.18.2"
    }
  }
}

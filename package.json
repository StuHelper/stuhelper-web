{
  "dependencies": {
    "qrcode": "1.5.4",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "4.6.4"
  },
  "engines": {
    "pnpm": "10.33.4",
    "node": "24.22.1"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "build": "pnpm run typecheck && vite build",
    "generate": "openapi-typescript contracts/platform.openapi.yaml -o src/api/platform.gen.ts && node scripts/generate-academic.mjs && openapi-typescript contracts/verification.openapi.yaml -o src/api/verification.gen.ts",
    "check:academic": "node scripts/check-academic-contracts.mjs",
    "test": "vitest run",
    "hooks": "lefthook install",
    "browser": "playwright test",
    "check": "pnpm run check:session && pnpm run check:verification && pnpm run check:resources && pnpm run check:academic && pnpm run check:i18n && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build",
    "typecheck": "vue-tsc --build",
    "dev": "vite --port 5173",
    "preview": "vite preview --port 5173",
    "check:i18n": "stuhelper-check i18n",
    "check:resources": "node scripts/check-resources.mjs",
    "check:verification": "node scripts/check-verification.mjs",
    "check:docs": "stuhelper-check docs",
    "check:session": "node scripts/check-session.mjs",
    "generate:session": "openapi-typescript contracts/session.openapi.json -o src/api/session.gen.ts"
  },
  "name": "@stuhelper/web",
  "packageManager": "pnpm@10.33.4",
  "private": true,
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "eslint-plugin-vue": "10.11.1",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "lefthook": "2.2.2",
    "@stuhelper/engineering-tools": "git+https://github.com/StuHelper/stuhelper-tooling.git#v0.1.0",
    "vite": "8.3.5",
    "@types/node": "26.6.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "happy-dom": "20.9.0",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@eslint/js": "10.0.1",
    "eslint-plugin-jsonc": "3.4.2",
    "typescript-eslint": "8.72.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@tsconfig/node24": "24.0.5",
    "@types/qrcode": "1.5.6"
  },
  "pnpm": {
    "overrides": {
      "katex": "0.18.2"
    }
  },
  "version": "0.0.0"
}

                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "业务拒绝或暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "业务拒绝或暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "业务拒绝或暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "onebot",
                      "connect",
                      "official"
                    ]
                  },
                  "revision": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F][^\\u0000-\\u001F\\u007F-\\u009F]*$"
                  }
                },
                "required": [
                  "kind",
                  "revision",
                  "reason"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/qq-binding/connect/confirm": {
      "post": {
        "operationId": "confirmConnect",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[ -~]*[!-~][ -~]*$"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "绑定成功，返回 Status。生产环境同步 Casdoor QQ 登录并读回成功后，connect.bound 为 true，connect_login 为 linked。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "400": {
            "description": "无效输入或 state，授权码已用或失败需重新授权（qq_binding_reauthorization_required），缺少 UnionID，QQ 未开通 UnionID 权限（qq_binding_unionid_permission_required），或回调地址未登记（qq_binding_redirect_uri_mismatch）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "会话缺失或已失效（qq_binding_unauthenticated）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "同源或 CSRF 校验失败（qq_binding_forbidden），或账号已关闭（qq_binding_account_closed）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "业务拒绝或暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "修订或幂等键冲突（qq_binding_revision_conflict）、Casdoor QQ 登录冲突（qq_binding_casdoor_conflict），或 OpenID/UnionID 已归属其他账号（qq_binding_ownership_conflict，可附 conflict_ref）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "业务拒绝或暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "QQ 互联能力关闭（qq_binding_connect_disabled）、配置缺失（qq_binding_connect_unconfigured）或依赖暂不可用。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "202": {
            "description": "qq_binding_processing：同一操作处理中，使用相同请求稍后查询。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "qq_binding_processing"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "code"
                ],
                "properties": {
                  "state": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F][^\\u0000-\\u001F\\u007F-\\u009F]*$"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F][^\\u0000-\\u001F\\u007F-\\u009F]*$"
                  }
                }
              }
            }
          }
        },
        "description": "Web 回调页使用当前登录会话提交 state 和 code。同键同内容重放保存的结果，处理中最长 15 秒。同键不同内容返回 409。服务端在请求 QQ 前占用授权码，同一授权码在 24 小时内最多交换一次。确认结果保留 24 小时。"
      }
    },
    "/api/v1/qq-binding/connect/cancel": {
      "post": {
        "operationId": "cancelConnect",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[ -~]*[!-~][ -~]*$"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "取消成功，返回 Status。使用 GET /api/v1/qq-binding/me 读取最新 connect_login。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "400": {
            "description": "业务拒绝或暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "会话缺失或已失效（qq_binding_unauthenticated）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "同源或 CSRF 校验失败（qq_binding_forbidden），或账号已关闭（qq_binding_account_closed）。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "业务拒绝或暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "业务拒绝或暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "业务拒绝或暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "QQ 互联能力关闭（qq_binding_connect_disabled）、配置缺失（qq_binding_connect_unconfigured）或依赖暂不可用。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F][^\\u0000-\\u001F\\u007F-\\u009F]*$"
                  }
                }
              }
            }
          }
        },
        "description": "QQ 回调携带授权错误时，Web 用当前登录会话提交 state。取消使 state 失效并返回当前绑定状态，无需请求 QQ。相同键及请求返回原结果，同键不同内容返回 409。Web 展示经固定映射的 QQ 错误。"
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "description": "qq_binding_already_bound 表示本项已绑定；qq_binding_ownership_conflict 仅表示身份属于其他账号。"
          },
          "conflict_ref": {
            "type": "string",
            "pattern": "^QQC-[A-Z2-7]{16}$",
            "description": "当 code 为 qq_binding_ownership_conflict 时返回的归属冲突核查单号，不含占用方信息。"
          }
        },
        "required": [
          "code"
        ]
      },
      "Part": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bound": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "bound_at": {
            "type": "string",
            "format": "date-time",
            "description": "当前槽位已绑定时的 UTC 绑定时间，未绑定时省略。"
          },
          "conflict_ref": {
            "type": "string",
            "pattern": "^QQC-[A-Z2-7]{16}$",
            "description": "本槽位未过期且仍被其他账号占用的冲突核查单号，无冲突或已绑定时省略。"
          }
        },
        "required": [
          "bound",
          "revision"
        ]
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "complete": {
            "type": "boolean"
          },
          "onebot": {
            "$ref": "#/components/schemas/Part"
          },
          "connect": {
            "$ref": "#/components/schemas/Part"
          },
          "official": {
            "$ref": "#/components/schemas/Part"
          },
          "qq_number": {
            "type": "string",
            "description": "已绑定 OneBot 时服务端脱敏后的 QQ 号码（保留末两位），未绑定时为空字符串。"
          },
          "connect_login": {
            "type": "string",
            "enum": [
              "unbound",
              "reauthorize",
              "linked",
              "out_of_sync",
              "unavailable"
            ],
            "description": "本人状态查询中的 Casdoor QQ 登录状态。配置了 Casdoor 同步时，确认成功也返回 linked。reauthorize 表示 Casdoor 已关联、StuHelper 尚缺 QQ 互联身份。out_of_sync 表示两侧 OpenID 状态不一致。"
          }
        },
        "required": [
          "complete",
          "onebot",
          "connect",
          "official",
          "qq_number"
        ]
      },
      "BotTarget": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "onebot",
              "official"
            ]
          },
          "bot_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "display_name": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "platform",
          "bot_id"
        ]
      },
      "Code": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "pattern": "^[A-Z2-7]{16}$"
          },
          "copy_text": {
            "type": "string",
            "pattern": "^StuHelper/(OB|QQ)-[A-Z2-7]{16}$",
            "description": "带平台前缀的可一键复制私聊口令。"
          },
          "bots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BotTarget"
            },
            "description": "当前验证码对应平台可用的目标机器人展示列表。"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "notice_key": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "copy_text",
          "bots",
          "expires_at",
          "notice_key"
        ]
      },
      "Authorization": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "url",
          "expires_at"
        ]
      },
      "BindingResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bound",
          "notice_key"
        ],
        "properties": {
          "bound": {
            "type": "boolean"
          },
          "notice_key": {
            "type": "string"
          }
        }
      },
      "ConflictInspection": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "conflict_ref": {
            "type": "string",
            "pattern": "^QQC-[A-Z2-7]{16}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "onebot",
              "connect",
              "official"
            ]
          },
          "requester_owner": {
            "type": "string"
          },
          "holder_owner": {
            "type": "string"
          },
          "holder_bound": {
            "type": "boolean"
          },
          "holder_revision": {
            "type": "integer",
            "format": "int64",
            "description": "冲突发生时的占用槽位修订。holder_bound 为 true 时可用于释放；旧核查单缺少修订时为 0。"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "conflict_ref",
          "kind",
          "requester_owner",
          "holder_owner",
          "holder_bound",
          "holder_revision",
          "created_at",
          "expires_at"
        ]
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "stuhelper_session"
      },
      "serviceBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}

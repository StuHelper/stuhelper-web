        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "platform": {
                    "type": "string",
                    "enum": [
                      "onebot",
                      "official"
                    ]
                  },
                  "bot_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F][^\\u0000-\\u001F\\u007F-\\u009F]*$"
                  },
                  "user_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F][^\\u0000-\\u001F\\u007F-\\u009F]*$"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 16,
                    "pattern": "^[A-Z2-7]{16}$"
                  }
                },
                "required": [
                  "platform",
                  "bot_id",
                  "user_id",
                  "code"
                ]
              }
            }
          }
        }
      }

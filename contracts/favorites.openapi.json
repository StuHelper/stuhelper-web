  "info": {
    "title": "StuHelper Favorites",
    "version": "0.1.0",
    "description": "Own favorite receipts and folders. New favorites require current content admission; own reads, moves and removals require login only. Titles are snapshots and do not grant access to public detail. Default folder has an empty name until renamed by its owner; clients localize the default label."
  },

  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Folder": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 20
          },
          "is_default": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "item_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Current number of own favorites in this folder, without kind or text filters."
          }
        },
        "required": [
          "id",
          "name",
          "is_default",
          "revision",
          "item_count"
        ]
      },
      "Item": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "course",
              "teacher",
              "resource"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "folder_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "target_id",
          "title",
          "folder_id",
          "revision",
          "created_at"
        ]
      },
      "Folders": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Folder"
            }
          },
          "next": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ]
      },
      "Items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "next": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "Name": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "Trim leading and trailing Unicode whitespace. Names must be unique within the owner folders (case-sensitive), including a renamed default folder."
          }
        },
        "required": [
          "name"
        ]
      },
      "Rename": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "Trim leading and trailing Unicode whitespace. Names must be unique within the owner folders (case-sensitive), including a renamed default folder."
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "revision"
        ]
      },
      "Revision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "required": [
          "revision"
        ]
      },
      "Add": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "course",
              "teacher",
              "resource"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "folder_id": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "target_id"
        ]
      },
      "Move": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "folder_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        },
        "required": [
          "folder_id",
          "revision"
        ]
      },
      "Removed": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "removed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "removed"
        ]
      }
    }
  }
}

  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "stuhelper_auth_session",
        "description": "The session must belong to a current platform administrator."
      }
    },
    "parameters": {
      "Slug": {
        "name": "slug",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        }
      },
      "Version": {
        "name": "version",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        }
      },
      "VariableKey": {
        "name": "key",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "document_version and effective_date are reserved for document-version metadata."
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 0
        }
      },
      "Csrf": {
        "name": "X-CSRF-Token",
        "in": "header",
        "description": "Session CSRF token. Mutations and preview also require an Origin allowed by the session configuration.",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "description": "Use one key for each distinct change. Retry with the same key, path, body and revision to retrieve the original result.",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        }
      },
      "ExpectedRevision": {
        "name": "If-Match",
        "in": "header",
        "description": "Quoted decimal revision of the stored record, for example \"7\".",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]{0,18}\"$"
        }
      }
    },
    "responses": {
      "InvalidInput": {
